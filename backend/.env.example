# ============================================================
# Borusan AI Ecosystem CRM - BACKEND environment (FastAPI)
# Copy to backend/.env for local runs. Never commit real .env files.
# ============================================================

# --- Database (SQL Server) ---
# Local SQL Server Express with Windows auth:
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS01/BorusanAIEcosystemCRM?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# SQL auth / containerized examples:
# DATABASE_URL=mssql+pyodbc://username:password@dbhost:1433/BorusanAIEcosystemCRM?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Deployment environment ---
# "development" enables Swagger/ReDoc/OpenAPI docs. ANY other value (including
# unset) runs as production and the docs endpoints return 404 (fail closed).
ENVIRONMENT=development

# --- Authentication ---
# Microsoft Entra ID single sign-on is the ONLY authentication method. The
# application stores no passwords and exposes no local sign-in endpoint, so
# there is no auth mode to choose and no JWT signing secret to configure.
AUTH_MODE=entra

# --- Initial admin record (optional) ---
# Used by "python -m app.db.seed" to pre-create an ADMIN row so section access
# can be set before that person's first sign-in. No credential is stored; they
# still authenticate through Entra ID. Prefer ENTRA_ADMIN_UPNS below instead.
INITIAL_ADMIN_EMAIL=admin@borusan.com
INITIAL_ADMIN_FULL_NAME=Initial Admin

# --- Microsoft Entra ID settings (required) ---
# Directory (tenant) ID from the Azure app registration:
ENTRA_TENANT_ID=
# Application (client) ID of the API app registration:
ENTRA_CLIENT_ID=
# Accepted token audience(s), comma-separated. Leave empty to accept the
# default: the bare ENTRA_CLIENT_ID, which is the audience of the OIDC ID token
# the frontend sends. The registration exposes no custom API.
ENTRA_AUDIENCE=
# Optional overrides; leave empty for standard Microsoft cloud endpoints.
ENTRA_ISSUER=
ENTRA_JWKS_URL=
# Comma-separated UPNs bootstrapped as ADMIN on their first SSO sign-in, e.g.:
# ENTRA_ADMIN_UPNS=emircan.sert@borusan.com
ENTRA_ADMIN_UPNS=

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
