{
  "info": {
    "name": "Borusan AI Ecosystem CRM - Security Scan Starter",
    "_postman_id": "00000000-0000-4000-8000-000000000000",
    "description": "Starter collection for Borusan Information Security. Authentication is Microsoft Entra ID SSO only: there is no login request to run. Sign in to the CRM in a browser, copy the Entra ID token it sends as the Authorization bearer, and set it as the {{token}} variable. Tokens expire in roughly 60 minutes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_upn",
      "value": "<admin_test_upn>"
    },
    {
      "key": "user_upn",
      "value": "<user_test_upn>"
    },
    {
      "key": "token",
      "value": "<entra_id_token>"
    },
    {
      "key": "organization_id",
      "value": "<organization_id>"
    },
    {
      "key": "import_batch_id",
      "value": "<import_batch_id>"
    }
  ],
  "item": [
    {
      "name": "Auth - Who am I",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "me"
          ]
        },
        "description": "Confirms the {{token}} Entra ID token is valid and shows the resolved CRM role. There is no login endpoint: POST /api/v1/auth/login returns 404 by design."
      }
    },
