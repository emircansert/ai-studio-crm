{
  "info": {
    "name": "Borusan AI Ecosystem CRM - Security Scan Starter",
    "_postman_id": "00000000-0000-4000-8000-000000000000",
    "description": "Starter collection for Borusan Information Security. Uses placeholder credentials and bearer token variables only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_email",
      "value": "<admin_test_email>"
    },
    {
      "key": "admin_password",
      "value": "<admin_test_password>"
    },
    {
      "key": "user_email",
      "value": "<user_test_email>"
    },
    {
      "key": "user_password",
      "value": "<user_test_password>"
    },
    {
      "key": "token",
      "value": "<jwt_token>"
    },
    {
      "key": "organization_id",
      "value": "<organization_id>"
    },
    {
      "key": "import_batch_id",
      "value": "<import_batch_id>"
    }
  ],
