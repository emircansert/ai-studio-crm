# ============================================================
# Borusan AI Ecosystem CRM - FRONTEND environment (Next.js)
# Copy to frontend/.env.local for local runs. Never commit real env files.
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle at build time.
# None of them are secrets. The Entra CLIENT SECRET is never used by the
# frontend (MSAL public-client PKCE flow) and must not appear here.
# ============================================================

# Browser requests go through the same-origin Next.js proxy:
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side proxy target (the FastAPI backend origin). Runtime variable.
BACKEND_API_ORIGIN=http://127.0.0.1:8001

# --- Microsoft Entra ID (the only sign-in method; both values required) ---
# Application (client) ID of the app registration (SPA platform):
NEXT_PUBLIC_ENTRA_CLIENT_ID=
# Directory (tenant) ID:
NEXT_PUBLIC_ENTRA_TENANT_ID=
# BASE origin for the Entra redirect. The app appends the dedicated callback
# path /auth/callback to this value, so set ONLY the origin here, e.g.
# https://library.borusan.com (or http://localhost:3000 for dev).
# The URI registered on the SPA platform in Azure must be the FULL value:
#   <this-value>/auth/callback   e.g. https://library.borusan.com/auth/callback
NEXT_PUBLIC_ENTRA_REDIRECT_URI=

# NOTE: there is deliberately no API-scope variable. The app registration
# grants only delegated Microsoft Graph permissions and exposes no custom API,
# so sign-in requests openid/profile/email/User.Read and the CRM API is
# authenticated with the OIDC ID token (audience = the client id above).
# Requesting an "api://<client-id>/..." scope against this registration fails
# with AADSTS500011 ("resource principal not found").
