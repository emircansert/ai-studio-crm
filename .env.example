# Borusan AI Ecosystem CRM local environment example.
# Copy this file to .env for local backend runs. Do not commit real .env files.

# SQL Server local database:
# Database name: BorusanAIEcosystemCRM

# SQL username/password examples:
DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/BorusanAIEcosystemCRM?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/BorusanAIEcosystemCRM?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Windows trusted connection examples:
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS01/BorusanAIEcosystemCRM?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# DATABASE_URL=mssql+pyodbc://@localhost:1433/BorusanAIEcosystemCRM?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Use a long random secret for any non-throwaway environment.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated local frontend origins. Do not use "*" with credentials in production-facing config.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend browser requests should use the same-origin Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Next.js rewrite/proxy target for /api/backend/* during local development.
# Use the backend origin only; /api/v1 is added by the frontend proxy.
BACKEND_API_ORIGIN=http://127.0.0.1:8000

# Used by python -m app.db.seed to create the first local ADMIN if missing.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-admin-password
INITIAL_ADMIN_FULL_NAME=Initial Admin

# Optional smoke test overrides.
SMOKE_API_BASE_URL=http://127.0.0.1:8000
SMOKE_ADMIN_EMAIL=admin@example.com
SMOKE_ADMIN_PASSWORD=change-me-admin-password
